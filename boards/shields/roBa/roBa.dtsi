#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout = &roba_physical_layout;
    };

    roba_physical_layout: roba_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys  //                     w   h    x    y     rot    rx    ry
            // row 0
            = <&key_physical_attrs 100 100    0   51       0     0     0>
            , <&key_physical_attrs 100 100  100   51       0     0     0>
            , <&key_physical_attrs 100 100  200   26       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400   13       0     0     0>
            , <&key_physical_attrs 100 100  500   26       0     0     0>
            , <&key_physical_attrs 100 100 1052   26       0     0     0>
            , <&key_physical_attrs 100 100 1152   13       0     0     0>
            , <&key_physical_attrs 100 100 1252    0       0     0     0>
            , <&key_physical_attrs 100 100 1352   26       0     0     0>
            , <&key_physical_attrs 100 100 1452   51       0     0     0>
            , <&key_physical_attrs 100 100 1552   51       0     0     0>
            // row 1
            , <&key_physical_attrs 100 100    0  151       0     0     0>
            , <&key_physical_attrs 100 100  100  151       0     0     0>
            , <&key_physical_attrs 100 100  200  126       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  113       0     0     0>
            , <&key_physical_attrs 100 100  500  126       0     0     0>
            , <&key_physical_attrs 100 100 1052  126       0     0     0>
            , <&key_physical_attrs 100 100 1152  113       0     0     0>
            , <&key_physical_attrs 100 100 1252  100       0     0     0>
            , <&key_physical_attrs 100 100 1352  126       0     0     0>
            , <&key_physical_attrs 100 100 1452  151       0     0     0>
            , <&key_physical_attrs 100 100 1552  151       0     0     0>
            // row 2
            , <&key_physical_attrs 100 100    0  251       0     0     0>
            , <&key_physical_attrs 100 100  100  251       0     0     0>
            , <&key_physical_attrs 100 100  200  226       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  213       0     0     0>
            , <&key_physical_attrs 100 100  500  226       0     0     0>
            , <&key_physical_attrs 100 100 1052  226       0     0     0>
            , <&key_physical_attrs 100 100 1152  213       0     0     0>
            , <&key_physical_attrs 100 100 1252  200       0     0     0>
            , <&key_physical_attrs 100 100 1352  226       0     0     0>
            , <&key_physical_attrs 100 100 1452  251       0     0     0>
            , <&key_physical_attrs 100 100 1552  251       0     0     0>
            // thumbs
            , <&key_physical_attrs 100 100  299  327       0     0     0>
            , <&key_physical_attrs 100 100  432  341       0     0     0>
            , <&key_physical_attrs 100 100  541  350    1000   591   400>
            , <&key_physical_attrs 100 100  651  380    2000   701   430>
            , <&key_physical_attrs 100 100  901  380 (-2000)   951   430>
            , <&key_physical_attrs 100 100 1011  350 (-1000)  1061   400>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <11>;
        rows = <4>;
        map = <
            RC(1,4)  RC(2,3)  RC(3,2)  RC(0,2)  RC(0,1)  RC(0,0)    RC(0,6)  RC(0,7)  RC(0,8)  RC(3,8)  RC(2,9)  RC(1,10)
            RC(2,4)  RC(3,3)  RC(0,3)  RC(1,2)  RC(1,1)  RC(1,0)    RC(1,6)  RC(1,7)  RC(1,8)  RC(0,9)  RC(3,9)  RC(2,10)
            RC(3,4)  RC(0,4)  RC(1,3)  RC(2,2)  RC(2,1)  RC(2,0)    RC(2,6)  RC(2,7)  RC(2,8)  RC(1,9)  RC(0,10) RC(3,10)
                              RC(1,5)  RC(2,5)  RC(3,1)  RC(3,0)    RC(3,6)  RC(3,7)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";
            row-gpios
                = <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                ;
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <12>;
        status = "disabled";
    };

    right_encoder: encoder_right {
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <10>;
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
    };
};

&spi0 {
    status = "disabled";

    trackball: trackball@0 {
        status = "disabled";
        reg = <0>;
    };
};
