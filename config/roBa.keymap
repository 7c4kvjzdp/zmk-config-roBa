#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// ---- 日本語配列（JIS）用の読み替え ------------------------------------------
// kot149/zmk-layout-shift で &kp を差し替え、US 配列のつもりで指定したキーを
// JIS 配列の PC 向けのキーに読み替えて送る（Studio で割り当てたキーにも効く）。
#include <layout_shift_kp_override.dtsi>

// Studio に保存済みの割り当ては behavior のデバイス名で &kp を参照している。
// override が付ける label を消し、デバイス名を元の "key_press" のままにする。
&kp {
    /delete-property/ label;
};

// key press 系の実体は 1 つだけにする（ドライバが instance 0 しか作らないため）
/delete-node/ &mtls;
/delete-node/ &kpls;

#define JIS_OPT (LAYOUT_SHIFT_OPTIONAL_CTRL | LAYOUT_SHIFT_OPTIONAL_ALT | LAYOUT_SHIFT_OPTIONAL_GUI)

/ {
    // 同梱の US->JIS マップから GRAVE（JIS の半角/全角）だけ外したもの。
    // 起動時に常に有効化する（src/jis_default_on.c）。切り替えキーは置かない。
    jis_map: jis_map {
        compatible = "zmk,layout-shift-map";
        mappings = <
            EQUAL             UNDERSCORE        JIS_OPT
            CARET             EQUAL             JIS_OPT
            TILDE             PLUS              JIS_OPT
            AT_SIGN           LEFT_BRACKET      JIS_OPT
            LEFT_BRACKET      RIGHT_BRACKET     JIS_OPT
            RIGHT_BRACKET     BACKSLASH         JIS_OPT
            LEFT_BRACE        RIGHT_BRACE       JIS_OPT
            RIGHT_BRACE       PIPE              JIS_OPT
            PLUS              COLON             JIS_OPT
            COLON             SINGLE_QUOTE      JIS_OPT
            ASTERISK          DOUBLE_QUOTES     JIS_OPT
            DOUBLE_QUOTES     AT_SIGN           JIS_OPT
            AMPERSAND         CARET             JIS_OPT
            SINGLE_QUOTE      AMPERSAND         JIS_OPT
            LEFT_PARENTHESIS  ASTERISK          JIS_OPT
            RIGHT_PARENTHESIS LEFT_PARENTHESIS  JIS_OPT
            UNDERSCORE        LS(0x87)          JIS_OPT
            BACKSLASH         0x89              JIS_OPT
            PIPE              LS(0x89)          JIS_OPT
        >;
    };
};
// -----------------------------------------------------------------------------

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5 6>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;

    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <13 14>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <14 15>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <13 12>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <22 23>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <26 27>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lt_mkp: lt_mkp {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Layer-Tap Mouse";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W  &kp E         &kp R                        &kp T        &kp LCTRL                          &kp DEL        &kp Y        &kp U  &lt 5 I    &kp O    &kp P
&kp A             &kp S  &kp D         &kp F                        &kp G        &kp LS(LG(S))                      &kp MINUS      &kp H        &kp J  &kp K      &kp L    &kp SQT
&mt LEFT_SHIFT Z  &kp X  &kp C         &kp V                        &kp B        &kp COLON                          &kp SEMICOLON  &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
                         &kp LEFT_ALT  &lt_to_layer_0 6 INT_HENKAN  &lt_mkp 5 MB3  &lt_to_layer_0 3 INT_MUHENKAN      &kp BACKSPACE  &lt 1 ENTER
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp N1       &kp N2        &kp N3           &kp N4         &kp N5
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp N6       &kp N7        &kp N8           &kp N9         &kp N0
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp KP_PLUS  &kp KP_MINUS  &kp KP_MULTIPLY  &kp KP_DIVIDE  &kp DOT
                &trans  &trans  &trans  &trans      &trans   &trans
            >;
        };

        NUM {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS      &trans                       &kp PIPE        &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL                    &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
                                             &trans           &trans           &trans        &trans                       &trans          &trans
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans          &trans                   &trans   &trans      &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
                &trans  &trans  &trans  &trans      &trans  &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans      &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans  &trans      &bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans          &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader     &trans        &trans        &trans        &trans        &bt BT_CLR
                      &trans        &trans        &trans  &trans      &trans          &trans
            >;
        };
    };
};
